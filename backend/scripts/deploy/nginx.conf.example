# =============================================================================
# Nginx 反向代理配置示例 —— 床垫选品小程序后端
#
# 用法：
#   1. 把本文件复制为 /etc/nginx/sites-available/mattress-ux
#   2. 把 api.example.com 换成你的真实域名（必须是已备案 + 微信小程序后台配过的域名）
#   3. ln -s /etc/nginx/sites-available/mattress-ux /etc/nginx/sites-enabled/
#   4. nginx -t && systemctl reload nginx
#
# 证书：wechat 小程序要求 HTTPS，用 certbot 自动签：
#   apt install -y certbot python3-certbot-nginx
#   certbot --nginx -d api.example.com
# =============================================================================

upstream mattress_api {
    # 后端 uvicorn 只监听 127.0.0.1:8000（见 systemd unit），不直接对外
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name api.example.com;

    # certbot 会自动把 80 重定向到 443；手工配置时取消下面注释
    # return 301 https://$host$request_uri;

    client_max_body_size 20m;   # 图片上传上限（后端 MAX_IMAGE_SIZE 默认 10MB，留余量）

    access_log /var/log/nginx/mattress-api.access.log;
    error_log  /var/log/nginx/mattress-api.error.log;

    location / {
        proxy_pass http://mattress_api;
        proxy_http_version 1.1;

        # 关键：FastAPI 靠这些头还原真实客户端信息
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # 图片上传 / 富文本可能较慢
        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    # 上传的图片由后端 StaticFiles 提供（STORAGE_DRIVER=local 时）
    # 若后续切到阿里云 OSS/腾讯云 COS，这段可删（图片不再走后端）
    location /uploads/ {
        proxy_pass http://mattress_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public";
    }
}


# 开发环境：后端 NG-01 实际端口/前缀（docker api = localhost:8000，路由前缀 /api/v1）
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 图片等静态资源 base（后端 /uploads/... 相对路径补全用；OSS 适配层落地前为本地 mock）
VITE_ASSET_BASE_URL=http://localhost:8000
# dev/自动化环境 mock wx.login（固定测试 code，后端 mock code2session，AGENTS.md 约定 4）
VITE_USE_WX_MOCK=true

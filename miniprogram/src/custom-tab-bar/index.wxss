/* 视觉真值：components/frame/TabBar.vue（variant=three），改动须两边同步 */
.tabbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 58px;
  padding: 0 28px;
  box-sizing: border-box;
  background-color: #ffffff;
  border-top: 1px solid #e9ecf2;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 64px;
  opacity: 0.6;
}

.tabbar-item--active {
  opacity: 1;
}

.tabbar-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 3px;
}

.tabbar-label {
  font-size: 10px;
  line-height: normal;
  color: #4a5165;
  text-align: center;
}

.tabbar-item--active .tabbar-label {
  color: #1a2260;
}
